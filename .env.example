# Notion Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_token_here

# The ID of the Notion page where you want to create databases
# Copy from the URL: https://notion.so/workspace/PAGE_ID
NOTION_PAGE_ID=your_page_id_here

# Soccer Schedule Tracker Database ID (filled automatically after running create_notion_soccer_db.py)
NOTION_DATABASE_ID=

# Release Tracker Database ID (filled automatically after running create_release_tracker.py)
RELEASE_DATABASE_ID=

# Football-Data.org API Configuration
# Get a free API key from: https://www.football-data.org/client/register
FOOTBALLDATA_API_KEY=your_api_key_here

# SMS/Email Configuration (for notifications via email-to-SMS gateway)
# Get Gmail App Password from: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Phone numbers to send notifications to (use carrier gateway addresses)
# Format: NUMBER@carrier-gateway.com
# Common carriers:
#   Verizon: NUMBER@vtext.com
#   AT&T: NUMBER@txt.att.net
#   T-Mobile: NUMBER@tmomail.net
#   Sprint: NUMBER@messaging.sprintpcs.com
#   Google Fi: NUMBER@msg.fi.google.com
SMS_RECIPIENTS=1234567890@vtext.com, 0987654321@vtext.com

# Send mode: "individual" (hidden from each other) or "group" (all recipients visible)
SMS_SEND_MODE=group

# Optional: Favorite teams for personalized messages
MY_FAVORITE_TEAM=Manchester United
WIFE_FAVORITE_TEAM=Brentford FC

# Team IDs for reference (Football-Data.org)
# Manchester United: 66
# Manchester City: 65
# Borussia Dortmund: 4
# Brentford FC: 401
# Arsenal: 57
# Liverpool: 64
# Chelsea: 61

# OLD API Keys (no longer used, kept for reference)
# API-Football (replaced with Football-Data.org)
# API_FOOTBALL_KEY=your_old_key_here

# Sportmonks API (not used)
# SPORTMONKS_API_KEY=your_key_here

# Twilio (not used - using email-to-SMS instead which is FREE)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# MY_PHONE_NUMBER=+1234567890
# WIFE_PHONE_NUMBER=+0987654321
